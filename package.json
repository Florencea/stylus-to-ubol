{
  "name": "stylus-to-ubol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "test:setup": "playwright install chromium",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/css-tree": "3.2.0",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-packagejson": "3.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
