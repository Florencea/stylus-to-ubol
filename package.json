{
  "name": "stylus-to-ubol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node --test test/e2e/app.test.js",
    "test:setup": "playwright install chromium",
    "test:unit": "node --test test/css-parser.test.js test/compiler.test.js test/storage.test.js",
    "verify": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1"
  }
}
