{
  "name": "stylus-to-ubol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/serve.js --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix .",
    "preview": "node scripts/serve.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node --test test/e2e/app.test.js",
    "test:setup": "playwright install chromium",
    "test:unit": "node --test test/compiler.test.js test/storage.test.js",
    "verify": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "rolldown": "1.3.3"
  }
}
